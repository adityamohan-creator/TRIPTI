# Copy to .env.local and fill in. Never commit .env.local.
# Only VITE_-prefixed vars reach the browser bundle, and everything here is
# public by design. The service role key belongs in backend/.env, never here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave unset in dev to use the Vite proxy at /api.
# VITE_API_BASE_URL=https://tripti-api.onrender.com

# Only needed if you switch the map from OSM tiles to Mapbox.
# VITE_MAPBOX_TOKEN=pk.your-token
